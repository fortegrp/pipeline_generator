def tool = params.TOOL.trim().toLowerCase()
def executionExitCode = 0
def runDir = "jenkins-runs/${env.BUILD_NUMBER}"
def artifactsDir = "${runDir}/artifacts"
def scriptsWorkspaceDir = "${runDir}/scripts-workspace"
def supportedTools = ['k6', 'jmeter', 'locust', 'gatling']

stage('Validate') {
  ['PROJECT', 'TOOL', 'SCENARIO', 'SCRIPT_BRANCH', 'SCRIPT_PATH'].each { paramName ->
    if (!params[paramName]?.trim()) {
      error "Required parameter ${paramName} must not be empty"
    }
  }

  if (!supportedTools.contains(tool)) {
    error "Unsupported tool '${tool}'. Supported tools: ${supportedTools.join(', ')}"
  }
}

stage('Prepare') {
  withEnv([
    "RUN_DIR=${runDir}",
    "ARTIFACTS_DIR=${artifactsDir}",
    "SCRIPTS_WORKSPACE_DIR=${scriptsWorkspaceDir}"
  ]) {
    sh '''
    set -eu
    rm -rf "${RUN_DIR}"
    mkdir -p \
      "${ARTIFACTS_DIR}/logs" \
      "${ARTIFACTS_DIR}/summaries" \
      "${ARTIFACTS_DIR}/metadata" \
      "${ARTIFACTS_DIR}/raw" \
      "${ARTIFACTS_DIR}/reports" \
      "${SCRIPTS_WORKSPACE_DIR}"

    if [ ! -f /var/jenkins_home/performance.env ]; then
      echo "Missing /var/jenkins_home/performance.env."
      echo "Create .env from .env.example and restart Jenkins."
      exit 1
    fi

    if ! command -v docker >/dev/null 2>&1; then
      echo "Docker CLI is not installed in the Jenkins container."
      echo "Rebuild Jenkins with: docker compose up -d --build --force-recreate jenkins"
      exit 127
    fi

    if ! command -v git >/dev/null 2>&1; then
      echo "git is not installed in the Jenkins container."
      exit 127
    fi

    docker version
  '''
  }
}

stage('Resolve run configuration') {
  withEnv([
    "PROJECT_PARAM=${params.PROJECT ?: ''}",
    "TOOL_PARAM=${tool}",
    "SCENARIO_PARAM=${params.SCENARIO}",
    "SCRIPT_BRANCH_PARAM=${params.SCRIPT_BRANCH}",
    "SCRIPT_PATH_PARAM=${params.SCRIPT_PATH}",
    "DESCRIPTION_PARAM=${params.DESCRIPTION ?: 'Jenkins performance run'}",
    "JENKINS_BUILD_NUMBER=${env.BUILD_NUMBER}",
    "ARTIFACTS_DIR=${artifactsDir}",
    "SCRIPTS_WORKSPACE_DIR=${scriptsWorkspaceDir}"
  ]) {
    sh '''#!/usr/bin/env bash
      set -euo pipefail

      set -a
      . /var/jenkins_home/performance.env
      set +a

      : "${PROJECT:?PROJECT is required in .env}"
      : "${SCRIPT_REPO_URL:?SCRIPT_REPO_URL is required in .env}"
      : "${INFLUXDB_URL:?INFLUXDB_URL is required in .env}"
      : "${INFLUXDB_BUCKET:?INFLUXDB_BUCKET is required in .env}"
      : "${INFLUXDB_ORG:?INFLUXDB_ORG is required in .env}"
      : "${INFLUXDB_TOKEN:?INFLUXDB_TOKEN is required in .env}"

      ENVIRONMENT="${ENVIRONMENT:-local}"
      if [ -n "${PROJECT_PARAM:-}" ]; then
        PROJECT="${PROJECT_PARAM}"
      fi

      SAFE_PROJECT="$(printf '%s' "${PROJECT}" | tr -c 'A-Za-z0-9_.-' '_')"
      SAFE_SCENARIO="$(printf '%s' "${SCENARIO_PARAM}" | tr -c 'A-Za-z0-9_.-' '_')"
      TEST_RUN_ID="${SAFE_PROJECT}_${SAFE_SCENARIO}_$(date -u +"%Y%m%dT%H%M%SZ")"
      EXECUTION_START_TIMESTAMP="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

      write_env() {
        printf '%s=%q\n' "$1" "$2"
      }

      {
        write_env PROJECT "${PROJECT}"
        write_env ENVIRONMENT "${ENVIRONMENT}"
        write_env TEST_RUN_ID "${TEST_RUN_ID}"
        write_env TOOL "${TOOL_PARAM}"
        write_env SCENARIO "${SCENARIO_PARAM}"
        write_env SCRIPT_REPO_URL "${SCRIPT_REPO_URL}"
        write_env SCRIPT_BRANCH "${SCRIPT_BRANCH_PARAM}"
        write_env SCRIPT_PATH "${SCRIPT_PATH_PARAM}"
        write_env RUN_DESCRIPTION "${DESCRIPTION_PARAM}"
        write_env JENKINS_BUILD_NUMBER "${JENKINS_BUILD_NUMBER}"
        write_env INFLUXDB_URL "${INFLUXDB_URL}"
        write_env INFLUXDB_BUCKET "${INFLUXDB_BUCKET}"
        write_env INFLUXDB_ORG "${INFLUXDB_ORG}"
        write_env EXECUTION_START_TIMESTAMP "${EXECUTION_START_TIMESTAMP}"
        write_env JENKINS_RUNS_TO_KEEP "${JENKINS_RUNS_TO_KEEP:-30}"
      } > "${ARTIFACTS_DIR}/raw/resolved-run.env"

      if [ -n "${SCRIPT_REPO_TOKEN:-}" ]; then
        cat > "${SCRIPTS_WORKSPACE_DIR}/git-askpass.sh" <<'EOF'
#!/usr/bin/env sh
case "$1" in
  *Username*) printf '%s\n' "${SCRIPT_REPO_USERNAME:-x-access-token}" ;;
  *Password*) printf '%s\n' "${SCRIPT_REPO_TOKEN}" ;;
  *) printf '\n' ;;
esac
EOF
        chmod 700 "${SCRIPTS_WORKSPACE_DIR}/git-askpass.sh"
        export GIT_ASKPASS="${PWD}/${SCRIPTS_WORKSPACE_DIR}/git-askpass.sh"
        export GIT_TERMINAL_PROMPT=0
      fi

      if ! git clone --depth 1 --branch "${SCRIPT_BRANCH_PARAM}" "${SCRIPT_REPO_URL}" "${SCRIPTS_WORKSPACE_DIR}/performance-scripts"; then
        echo "Git clone failed for SCRIPT_REPO_URL=${SCRIPT_REPO_URL}"
        echo "If the repository is private, set SCRIPT_REPO_TOKEN in .env and restart Jenkins."
        exit 1
      fi

      if [ ! -f "${SCRIPTS_WORKSPACE_DIR}/performance-scripts/${SCRIPT_PATH_PARAM}" ]; then
        echo "Script was not found: ${SCRIPT_PATH_PARAM}"
        echo "Scripts repository: ${SCRIPT_REPO_URL}"
        echo "Branch: ${SCRIPT_BRANCH_PARAM}"
        exit 1
      fi

      echo "Resolved run:"
      cat "${ARTIFACTS_DIR}/raw/resolved-run.env"
    '''
  }
}

stage('Run tool in Docker') {
  withEnv([
    "ARTIFACTS_DIR=${artifactsDir}",
    "SCRIPTS_WORKSPACE_DIR=${scriptsWorkspaceDir}"
  ]) {
    executionExitCode = sh(returnStatus: true, script: '''#!/usr/bin/env bash
    set -uo pipefail

    set -a
    . /var/jenkins_home/performance.env
    . "${ARTIFACTS_DIR}/raw/resolved-run.env"
    set +a

    ROOT_DIR="$(pwd)"
    START_EPOCH="$(date +%s)"
    CONTAINER_ID=""
    EXIT_CODE=1
    RUNTIME_WRITTEN=false
    SAFE_TEST_RUN_ID="$(printf '%s' "${TEST_RUN_ID}" | tr -c 'A-Za-z0-9_.-' '-')"
    CONTAINER_NAME="performance-${SAFE_TEST_RUN_ID}-${JENKINS_BUILD_NUMBER}"

    exec > >(tee -a "${ARTIFACTS_DIR}/logs/execution.log") 2>&1

    write_runtime() {
      END_EPOCH="$(date +%s)"
      DURATION_SECONDS="$((END_EPOCH - START_EPOCH))"

      cat > "${ARTIFACTS_DIR}/metadata/execution-runtime.json" <<EOF
{
  "container_id": "${CONTAINER_ID}",
  "container_name": "${CONTAINER_NAME}",
  "execution_duration_seconds": ${DURATION_SECONDS},
  "exit_code": ${EXIT_CODE},
  "artifact_paths": {
    "logs": "artifacts/logs",
    "summaries": "artifacts/summaries",
    "metadata": "artifacts/metadata",
    "raw": "artifacts/raw",
    "reports": "artifacts/reports"
  }
}
EOF
      RUNTIME_WRITTEN=true
    }

    finish() {
      status=$?
      if [ "${RUNTIME_WRITTEN}" != "true" ]; then
        if [ "${EXIT_CODE}" = "1" ] && [ "${status}" -ne 0 ]; then
          EXIT_CODE="${status}"
        fi
        write_runtime
      fi
      docker rm -f "${CONTAINER_NAME}" >/dev/null 2>&1 || true
      exit "${EXIT_CODE}"
    }

    trap finish EXIT INT TERM

    RUNNER_IMAGE="performance-runner-${TOOL}:local"
    RUNNER_DIR="runners/${TOOL}"
    if [ ! -d "${RUNNER_DIR}" ]; then
      echo "Runner directory was not found: ${RUNNER_DIR}"
      EXIT_CODE=2
      exit "${EXIT_CODE}"
    fi

    if docker image inspect "${RUNNER_IMAGE}" >/dev/null 2>&1; then
      echo "Using existing runner image: ${RUNNER_IMAGE}"
    else
      echo "Building runner image: ${RUNNER_IMAGE}"
      docker build -t "${RUNNER_IMAGE}" "${RUNNER_DIR}"
      build_status=$?
      if [ "${build_status}" -ne 0 ]; then
        echo "Runner image build failed with exit code ${build_status}"
        EXIT_CODE="${build_status}"
        exit "${EXIT_CODE}"
      fi
    fi

    docker rm -f "${CONTAINER_NAME}" >/dev/null 2>&1 || true

    echo "Starting performance container: ${CONTAINER_NAME}"
    rm -f "${ARTIFACTS_DIR}/raw/container-id.txt"

    docker run \
      -d \
      --cidfile "${ARTIFACTS_DIR}/raw/container-id.txt" \
      --name "${CONTAINER_NAME}" \
      --label paas.execution=true \
      --label paas.tool="${TOOL}" \
      --label paas.testRunID="${TEST_RUN_ID}" \
      --network performance-execution \
      --log-driver json-file \
      --log-opt max-size=10m \
      --log-opt max-file=3 \
      -e PROJECT="${PROJECT}" \
      -e ENVIRONMENT="${ENVIRONMENT}" \
      -e TEST_RUN_ID="${TEST_RUN_ID}" \
      -e TOOL="${TOOL}" \
      -e SCENARIO="${SCENARIO}" \
      -e SCRIPT_PATH="${SCRIPT_PATH}" \
      -e JENKINS_BUILD_NUMBER="${JENKINS_BUILD_NUMBER}" \
      -e RUN_DESCRIPTION="${RUN_DESCRIPTION}" \
      -e EXECUTION_START_TIMESTAMP="${EXECUTION_START_TIMESTAMP}" \
      -e INFLUXDB_URL="${INFLUXDB_URL}" \
      -e INFLUXDB_BUCKET="${INFLUXDB_BUCKET}" \
      -e INFLUXDB_ORG="${INFLUXDB_ORG}" \
      -e INFLUXDB_TOKEN="${INFLUXDB_TOKEN}" \
      -e ARTIFACTS_DIR="/artifacts" \
      -e SCRIPTS_DIR="/scripts" \
      -v "${ROOT_DIR}/${SCRIPTS_WORKSPACE_DIR}/performance-scripts:/scripts:ro" \
      -v "${ROOT_DIR}/${ARTIFACTS_DIR}:/artifacts" \
      "${RUNNER_IMAGE}"
    run_status=$?
    if [ "${run_status}" -ne 0 ]; then
      echo "Container start failed with exit code ${run_status}"
      EXIT_CODE="${run_status}"
      exit "${EXIT_CODE}"
    fi

    if [ -f "${ARTIFACTS_DIR}/raw/container-id.txt" ]; then
      CONTAINER_ID="$(cat "${ARTIFACTS_DIR}/raw/container-id.txt")"
    else
      CONTAINER_ID=""
    fi

    echo "Container ID: ${CONTAINER_ID}"
    docker inspect "${CONTAINER_NAME}" --format '{{.HostConfig.LogConfig.Type}}' > "${ARTIFACTS_DIR}/raw/container-log-driver.txt" || true
    echo "Container log driver: $(cat "${ARTIFACTS_DIR}/raw/container-log-driver.txt" 2>/dev/null || echo unknown)"
    echo "Waiting for container to finish. Tool output is written to artifacts/logs inside the mounted artifacts directory."

    EXIT_CODE="$(docker wait "${CONTAINER_NAME}")"

    write_runtime
    docker rm -f "${CONTAINER_NAME}" >/dev/null 2>&1 || true
    trap - EXIT INT TERM

    exit "${EXIT_CODE}"
  ''')
  }
}

stage('Package artifacts') {
  withEnv([
    "RUN_DIR=${runDir}",
    "ARTIFACTS_DIR=${artifactsDir}",
    "JENKINS_BUILD_NUMBER=${env.BUILD_NUMBER}"
  ]) {
    sh '''
    set -eu
    for file in \
      "${ARTIFACTS_DIR}/metadata/execution-metadata.json" \
      "${ARTIFACTS_DIR}/metadata/execution-runtime.json" \
      "${ARTIFACTS_DIR}/summaries/execution-summary.json" \
      "${ARTIFACTS_DIR}/logs/execution.log"
    do
      if [ ! -f "$file" ]; then
        echo "Expected artifact was not found: $file"
        exit 1
      fi
    done

    find "${ARTIFACTS_DIR}" -maxdepth 3 -type f | sort
    tar -czf "${RUN_DIR}/performance-artifacts-${JENKINS_BUILD_NUMBER}.tar.gz" -C "${RUN_DIR}" artifacts
  '''
  }
}

stage('Publish artifact archive') {
  archiveArtifacts artifacts: "${runDir}/performance-artifacts-*.tar.gz", allowEmptyArchive: false, fingerprint: true
}

stage('Cleanup old local runs') {
  withEnv(["CURRENT_RUN_DIR=${runDir}", "ARTIFACTS_DIR=${artifactsDir}"]) {
    sh '''#!/usr/bin/env bash
      set -euo pipefail

      set -a
      . "${ARTIFACTS_DIR}/raw/resolved-run.env"
      set +a

      keep="${JENKINS_RUNS_TO_KEEP:-30}"
      case "${keep}" in
        ''|*[!0-9]*) keep=30 ;;
      esac

      if [ "${keep}" -lt 1 ]; then
        keep=1
      fi

      if [ ! -d jenkins-runs ]; then
        exit 0
      fi

      find jenkins-runs -mindepth 1 -maxdepth 1 -type d -name '[0-9]*' \
        | sort -V \
        | head -n "-${keep}" \
        | while IFS= read -r old_run; do
            if [ "${old_run}" != "${CURRENT_RUN_DIR}" ]; then
              echo "Removing old local run: ${old_run}"
              rm -rf "${old_run}"
            fi
          done
    '''
  }
}

if (executionExitCode != 0) {
  error "Performance execution failed with exit code ${executionExitCode}"
}
